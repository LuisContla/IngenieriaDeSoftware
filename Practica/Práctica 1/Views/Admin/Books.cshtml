@model IEnumerable<Práctica_1.Models.Libro>

@{
    ViewData["Title"] = "Gestionar Libros";
    Layout = null;
    var favoritos = ViewBag.Favoritos as List<int> ?? new List<int>();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5.3 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="~/js/theme-toggle.js"></script>
</head>
<body>
    <button class="back-button" onclick="window.location.href='/Admin/Index'">🏠</button>
    <button id="modoToggle" class="mode-button mode-nonIndex">
        <span id="modoIcono">🌙</span>
    </button>

    <div class="container">
        <h1>📚 Gestión de Libros</h1>

        <form asp-controller="Libros" asp-action="Create" method="get" class="d-inline">
            <button type="submit" class="btn">➕ Crear Libro</button>
        </form>

        <br /><br />

        <form method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="🔍 Buscar por título, autor o descripción" />
                <button type="submit" class="btn btn-buscar">Buscar</button>
            </div>
        </form>

        <div class="grid">
            @foreach (var libro in Model)
            {
                <div class="book">
                    <a asp-controller="Libros" asp-action="Detalles" asp-route-id="@libro.Id">
                        @if (!string.IsNullOrEmpty(libro.ImagenUrl))
                        {
                            <img src="@libro.ImagenUrl" alt="@libro.Titulo">
                        }
                        <p class="fw-bold">@libro.Titulo</p>
                    </a>
                    <p>@libro.Autor</p>

                    @if (favoritos.Contains(libro.Id))
                    {
                        <form asp-controller="Favoritos" asp-action="EliminarPorLibro" method="post" class="d-inline">
                            <input type="hidden" name="libroId" value="@libro.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Books", "Admin")" />
                            <button type="submit" class="btn btn-quitarFavorito">💔 Quitar de favoritos</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Favoritos" asp-action="Agregar" method="post" class="d-inline">
                            <input type="hidden" name="libroId" value="@libro.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Books", "Admin")" />
                            <button type="submit" class="btn btn-favorito">💖 Agregar a favoritos</button>
                        </form>
                    }


                    <form asp-controller="Libros" asp-action="Edit" asp-route-id="@libro.Id" method="get" class="d-inline">
                        <button class="btn btnEditar">✏️ Editar</button>
                    </form>
                    <form asp-controller="Libros" asp-action="Delete" asp-route-id="@libro.Id" method="get" class="d-inline">
                        <button class="btn btn-delete">🗑️ Eliminar</button>
                    </form>
                </div>
            }

        </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No se encontraron libros que coincidan con "<strong>@ViewBag.Search</strong>".
                </div>
            }

        <br />

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Navegación de páginas">
                <ul class="pagination justify-content-center">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Books" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">
                                « Anterior
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Books" asp-route-page="@i" asp-route-search="@ViewBag.Search">
                                @i
                            </a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Books" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">
                                Siguiente »
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>

    <!-- Bootstrap Bundle JS (con Popper incluido) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>