@model Práctica_1.Models.Libro
@{
    ViewBag.Title = "Agregar Libro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="~/js/theme-toggle.js"></script>
</head>
<body>
    @* <button class="back-button" onclick="history.back()">⬅️ Volver</button> *@
    <button id="modoToggle" class="mode-button mode-nonIndex">
        <span id="modoIcono">🌙</span>
    </button>
    <div class="container">
        <h2 class="mb-4">Agregar nuevo libro</h2>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Autor</label>
                <input asp-for="Autor" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">URL de imagen</label>
                <input asp-for="ImagenUrl" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success">💾 Guardar</button>
            <a asp-controller="Admin" asp-action="Books" class="btn btn-secondary">❌ Cancelar</a>
        </form>

    </div>
</body>
</html>