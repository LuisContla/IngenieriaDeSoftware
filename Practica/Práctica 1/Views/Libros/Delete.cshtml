@model Práctica_1.Models.Libro
@{
    ViewBag.Title = "Eliminar Libro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="~/js/theme-toggle.js"></script>
</head>
<body>
    @* <button class="back-button" onclick="history.back()">⬅️ Volver</button> *@
    <button id="modoToggle" class="mode-button mode-nonIndex">
        <span id="modoIcono">🌙</span>
    </button>
    <div class="container">
        <h2 class="mb-4 text-danger">¿Estás seguro de eliminar este libro?</h2>

        <div class="border p-3 mb-3">
            <img src="https://covers.openlibrary.org/b/id/8235535-L.jpg" alt="Portada del libro">
            <h4>@Model.Titulo</h4>
            <p><strong>Autor:</strong> @Model.Autor</p>
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">🗑️ Eliminar</button>
            <a asp-controller="Admin" asp-action="Books" class="btn btn-secondary">❌ Cancelar</a>
        </form>
    </div>
</body>
</html>


