@{
    @model IEnumerable<Práctica_1.Models.Usuario>
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <head>
        <!-- Agregar jQuery -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <!-- Agregar Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <!-- Agregar Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    </head>

    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="users-body">

    <button class="back-button" onclick="window.location.href='/Admin/Index'">⬅️ Volver</button>

    <div class="container users-container">
        @if (ViewBag.ErrorMessage != null)
        {
            <div style="color: red;">@ViewBag.ErrorMessage</div>
        }
        <h1>👤 Gestión de Usuarios</h1>
        <button class="btn" onclick="openCreateModal()">➕ Crear Usuario</button>
        <table>
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Contraseña</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Correo</td>
                    <td>@usuario.Contraseña</td>
                    <td>@(usuario.Rol == 1 ? "Admin" : "Usuario")</td>
                    <td class="btn-container">
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalEdit" data-id="@usuario.Id">✏️ Editar</button>
                        <form method="post" action="@Url.Action("Delete", "Admin", new { id = usuario.Id })" onsubmit="return confirm('¿Estás seguro de que deseas eliminar a este usuario?');">
                            <button type="submit" class="btn btn-delete">🗑️ Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    </div>

    <!-- Modal Crear Usuario -->
    <div id="modalCreate" style="display:none; position:fixed; top:20%; border-radius:10px; color:black; justify-self:center; align-self:center;">
        <form method="post" action="@Url.Action("Create", "Admin")">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Crear Nuevo Usuario</h5>
                        <button onclick="closeCreateModal()" type="button" class="btn-close" data-bs-dismiss="modalCreate" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div>
                            <label for="nombre">Nombre:</label>
                            <input class="form-control"  type="text" id="nombre" name="nombre" required />
                        </div>
                        <div>
                            <label for="correo">Correo:</label>
                            <input class="form-control" type="email" id="correo" name="correo" required />
                        </div>
                        <div>
                            <label for="contraseña">Contraseña:</label>
                            <input class="form-control" type="password" id="contraseña" name="contraseña" required />
                        </div>
                        <div>
                            <label for="rol">Rol:</label>
                            <select class="form-control" name="rol" id="rol" required>
                                <option value="0">Usuario Normal</option>
                                <option value="1">Administrador</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button onclick="closeCreateModal()" type="button" class="btn btn-secondary" data-bs-dismiss="modalCreate">Cerrar</button>
                        <button type="submit" class="btn btn-primary">Crear Usuario</button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Modal Editar Usuario -->
    <div id="modalEdit" style="display:none; position:fixed; bottom:20%; border-radius:10px; color:black; justify-self:center; align-self:center;">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- El contenido del modal se llenará con la vista parcial -->
            </div>
        </div>
    </div>


    <script>
        function openCreateModal() { document.getElementById("modalCreate").style.display = "block"; }
        function closeCreateModal() { document.getElementById("modalCreate").style.display = "none"; }
        function closeEditModal() { document.getElementById("modalEdit").style.display = "none"; }

                $(document).ready(function () {
            // Cuando el botón de edición sea clickeado
            $('button[data-target="#modalEdit"]').on('click', function () {
                var userId = $(this).data('id'); // Obtener el ID del usuario desde el botón

                // Realizar la llamada AJAX para obtener la vista parcial
                $.get('/Admin/EditUser/' + userId, function (data) {
                    // Colocar el contenido de la vista parcial dentro del modal
                    $('#modalEdit .modal-content').html(data);

                    // Asegurarse de que cualquier backdrop generado por Bootstrap sea eliminado
                    $('.modal-backdrop').remove(); // Elimina cualquier fondo oscuro generado por Bootstrap

                    // Mostrar el modal
                    $('#modalEdit').css('display', 'block'); // Asegurarnos de que el modal se muestre correctamente
                    $('#modalEdit').addClass('show'); // Esto agrega la clase 'show' que hace visible el modal
                }).fail(function () {
                    // Mostrar un mensaje de error si la llamada AJAX falla
                    alert('Hubo un error al cargar el formulario de edición.');
                });
            });
        });



    </script>
</body>
</html>
