@model Práctica_1.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registro</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="icon" href="~/img/UserIcon.png" />
</head>
<body class="login-body">

    @{
        var errorMessage = ViewBag.Error as string ?? ""; // Si ViewBag.Error es null, asigna una cadena vacía
        var successMessage = ViewBag.SuccessMessage as string ?? ""; // Si ViewBag.SuccessMessage es null, asigna una cadena vacía
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-center">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success text-center">@successMessage</div>
    }

    <form method="post" class="login">
        <h1>REGISTRO</h1>
        <input type="text" name="Usuario" id="Usuario" class="form-control" placeholder="Usuario" required />
        <input type="email" name="Correo" id="Correo" class="form-control" placeholder="Correo" required />
        <input type="password" name="Contraseña" id="Contraseña" class="form-control" placeholder="Contraseña" required />
        <button type="submit">Crear Cuenta</button>
        <br /><br />
        <a href="/Auth/Login" class="login-a">Ya tengo una cuenta</a>
    </form>

</body>
</html>