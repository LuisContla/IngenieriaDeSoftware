@{
    ViewData["Title"] = "Bienvenido a la Biblioteca";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <button class="logout-button" onclick="logout()">🔒 Cerrar Sesión</button>
    <div class="container">
        <h1>📚 Biblioteca Virtual</h1>
        <h2 id="welcome-message">👋 ¡Bienvenido, Usuario!</h2>
        <div class="option" onclick="window.location.href='/Home/Users'">👤 Gestionar Usuarios</div>
        <div class="option" onclick="window.location.href='/Home/Books'">📖 Ver Libros Disponibles</div>
    </div>

    <script>
        // Simulación de obtener el nombre del usuario (puede venir de un backend o localStorage)
        let usuario = localStorage.getItem("usuario") || "Usuario";
        document.getElementById("welcome-message").textContent = `👋 ¡Bienvenido, ${usuario}!`;

        // Función para cerrar sesión
        function logout() {
            alert("Sesión cerrada. ¡Hasta pronto!");
            localStorage.removeItem("usuario"); // Borra el usuario almacenado
            window.location.href = "/Auth/Login"; // Redirige al login
        }
    </script>

</body>
</html>
