@model Tarea_3.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="icon" href="~/img/UserIcon.png" />
</head>
<body class="login-body">

    @{
        var errorMessage = ViewBag.Error as string ?? ""; // Si ViewBag.Error es null, asigna una cadena vacía
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-center">@errorMessage</div>
    }

    <form method="post" class="login">
        <h1>LOGIN</h1>
        <input type="text" name="Usuario" id="Usuario" placeholder="Usuario" required />
        <input type="password" name="Contraseña" id="Contraseña" placeholder="Contraseña" required />
        <button type="submit">Iniciar sesión</button>
        <br /><br />
        <a href="/Auth/Register" class="login-a">Aún no tengo una cuenta</a>
    </form>

</body>
</html>