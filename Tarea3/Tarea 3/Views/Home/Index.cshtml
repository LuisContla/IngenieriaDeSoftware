@{
    ViewData["Title"] = "Bienvenido a la Biblioteca";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        /* Estilos generales */
        body {
            font-family: 'Georgia', serif;
            margin: 0;
            padding: 0;
            color: #fff;
            background-color: #399C8C;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        /* Contenedor principal */
        .container {
            background: rgba(0, 0, 0, 0.7);
            padding: 40px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.3);
        }

        /* Cabecera */
        header h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        /* Nombre del usuario */
        #username {
            color: #f4c542;
            font-weight: bold;
        }

        /* Mensaje */
        .message {
            font-size: 20px;
            margin-top: 10px;
            font-style: italic;
        }

        /* Botón de cerrar sesión */
        button {
            background-color: #d9534f;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #c9302c;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📖 Bienvenido, <span id="username">@ViewBag.UserName</span></h1>
            <p class="message">Descubre nuevas historias y deja que los libros te transporten a otros mundos.</p>
            <p class="message">PRÓXIMAMENTE...</p>
        </header>
        <main>
            <form method="post" action="@Url.Action("Logout", "Auth")">
                <button type="submit">Cerrar sesión</button>
            </form>
        </main>
    </div>
</body>
</html>
